{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notely",
  "version": "0.1.0",
  "identifier": "com.notely.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Notely",
        "url": "/",
        "width": 820,
        "height": 540,
        "minWidth": 380,
        "minHeight": 360,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "visible": true,
        "focus": true,
        "resizable": true,
        "contentProtected": true,
        "center": true,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "./entitlements.mac.plist",
      "infoPlist": "./Info.plist"
    }
  }
}
