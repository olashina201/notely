{
  "name": "notely",
  "version": "0.1.0",
  "private": true,
  "description": "Notely — your macOS AI companion for conversations, screen context, and meeting notes. Gemini, OpenAI, and Claude.",
  "type": "module",
  "scripts": {
    "icons:generate": "node scripts/generate-icons.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:sign": "node scripts/sign-macos.mjs",
    "app:bundle": "npm run tauri -- build --debug --bundles app && npm run app:sign",
    "app:build": "npm run tauri -- build --bundles app && npm run app:sign -- src-tauri/target/release/bundle/macos/Notely.app",
    "app:run": "npm run app:build && open src-tauri/target/release/bundle/macos/Notely.app",
    "app:build:windows": "tauri build --bundles nsis"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
